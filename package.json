{
  "name": "poker-app",
  "version": "1.0.0",
  "description": "Mobile-first poker game management system",
  "main": "api/index.js",
  "scripts": {
    "test": "jest",
    "start": "node api/index.js",
    "dev": "vercel dev",
    "dev:local": "node -e \"require('dotenv').config({path:'.env.local'}); require('./api/index.js').listen(process.env.PORT||3000, () => console.log('Running on http://localhost:' + (process.env.PORT||3000)))\""
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "4.22.1",
    "mongoose": "8.23.1"
  },
  "devDependencies": {
    "fast-check": "3.23.2",
    "jest": "29.7.0",
    "supertest": "7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "public/(?!lib/.*\\.test\\.js)"
    ]
  }
}
